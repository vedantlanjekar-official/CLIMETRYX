NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# non_commercial or commercial. Required before any Open-Meteo call.
OPEN_METEO_MODE=
OPEN_METEO_CUSTOMER_API_KEY=
OPEN_METEO_FORECAST_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_BASE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_FLOOD_BASE_URL=https://flood-api.open-meteo.com/v1/flood
OPEN_METEO_CLIMATE_BASE_URL=https://climate-api.open-meteo.com/v1/climate

# AI Reports Centre (server-only; never prefix with NEXT_PUBLIC_ and never paste the key into the app).
# Without OPENAI_API_KEY every report is still generated, with a rules-written narrative.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Optional: prices in USD per million tokens, used only to estimate cost in ai_usage_events.
OPENAI_PRICE_INPUT_PER_MTOK=
OPENAI_PRICE_OUTPUT_PER_MTOK=
# Set to true to switch AI narratives off without removing the key.
AI_REPORTS_DISABLED=

# Optional grounded summary through the Vercel AI Gateway. Without a key the summary is written by rules.
AI_GATEWAY_API_KEY=
AI_NARRATIVE_MODEL=google/gemini-3.8-flash

CCKP_API_BASE_URL=https://cckpapi.worldbank.org/cckp/v1
COPERNICUS_STAC_URL=https://stac.dataspace.copernicus.eu/v1/
COPERNICUS_CLIENT_ID=
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=
MAPTILER_API_KEY=
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
CRON_SECRET=

# Optional documented authority feed. Leave empty until a real warning source is selected.
OFFICIAL_ALERTS_FEED_URL=
